  "bindings": {
    "web/src/SourceField.vue": [
      "import SourceObject",
      "<SourceObject",
      "import SourceCommission",
      "<SourceCommission",
      "import SourceSatchel",
      "<SourceSatchel",
      "useActivityPresentation(a=>a.version===2&&a.plan.sourceId===props.plan.sourceId"
    ],
    "web/src/SourcePlanner.vue": [
      "<SourceField",
      "source-plan-open",
      "source-start",
      "@arrange=\"settings?.showModal()\""
    ],
    "web/src/SourceObject.vue": [
      "SOURCE_ART[sourceId]",
      "projectSourceWork(props.state,props.progress)",
      "data-testid=\"source-physical-object\"",
      "emit('arrange')"
    ],
    "web/src/SourceCommission.vue": [
      "COMMISSION_OBJECTS[props.sourceId as keyof typeof COMMISSION_OBJECTS]",
      "projectSourceWork(props.state,props.progress)",
      "data-testid=\"source-commission-object\"",
      "emit('arrange')"
    ],
    "web/src/SourceSatchel.vue": [
      "sourceHoldings(props.game,props.sourceId)",
      "sourcePeriodTotals(props.game,props.sourceId,props.activity)",
      "savedSourceYield(props.game,props.sourceId,props.activity,props.result)",
      "props.sequence>0?",
      "data-testid=\"source-satchel\""
    ],
    "web/src/source-choreography.ts": [
      "export const SOURCE_ART",
      "export const COMMISSION_OBJECTS",
      "quantity:item==='stones'?game.core.player.stones:game.core.inventory[item]",
      "if(activity?.version!==2||activity.runId!==game.core.runId||activity.plan.sourceId!==id)return null;",
      "result.type!=='SOURCE'||result.executedSteps!==1||result.requestedSteps!==1",
      "result.runId!==game.core.runId||result.revisionAfter!==game.core.revision",
      "activity.runId!==game.core.runId||activity.gameRevision!==result.revisionAfter",
      "result.commandId!==`cycle:${activity.id}:${activity.generation}:${activity.completedCycles}`",
      "Object.entries(result.delta.inventory)",
      "if(result.delta.stones>0)items.push({id:'stones',name:'灵石',quantity:result.delta.stones});",
      "Number.isFinite(value)",
      "working=state==='working'",
      "art/v2/sources/herbs-cold-v1.webp",
      "art/v2/sources/dew-cold-v1.webp",
      "art/v2/sources/jade-cold-v1.webp",
      "art/v2/sources/lotus-cold-v1.webp",
      "art/v2/sources/soul-cold-v1.webp",
      "art/v2/sources/dao-cold-v1.webp"
    ],
    "web/src/use-activity-effect.ts": [
      "createActivityEffectTracker(matches,extra)",
      "!store?.activityPausing",
      "activity.value?.ownerId",
      "timer=setTimeout(()=>effect.value=null,1400)"
    ],
    "web/src/activity-effects.ts": [
      "a.version&&[2,3,6,extra].includes(a.version)",
      "resolve(before,command)",
      "completeActivity(g,prior,r,",
      "proof(resolved.nextState)!==proof(g)",
      "proof(expected)!==proof(a)"
    ]
  },
  "userAcceptance": false
}
