    "web/src/BattleDeck.vue": [
      "import BattleCommandConsole",
      "<BattleCommandConsole"
    ],
    "web/src/BattlePresence.vue": [
      "BATTLE_PLAYER_ASSET",
      "useBattlePreparation",
      ":data-run=\"game.core.runId\"",
      ":data-enemy=\"battle.enemy\"",
      ":data-stage=\"game.trial?.stage??'ordinary'\"",
      ":data-revision=\"game.core.revision\"",
      "data-testid=\"battle-preparation\""
    ],
    "web/src/ActionFeedbackStage.vue": [
      "import BattleCast",
      "<BattleCast",
      "useBattleWitness",
      "witness.capture(value);observation.value=value;",
      "witness.forNotice(next)",
      "battleSpot(cast)",
      "castActors(next,cast,mark)",
      "clearBattlePose(element)"
    ],
    "web/src/assets.ts": [
      "BATTLE_PLAYER_ASSET='art/v2/actors/player-standing-cold-v1.webp'"
    ],
    "web/src/BattleCommandConsole.vue": [
      "import './ta07-commands.css'",
      "data-testid=\"battle-command-console\"",
      "data-testid=\"battle-strike-slots\"",
      "data-testid=\"battle-medicine-kit\"",
      "data-testid=\"battle-retreat-lane\"",
      "['attack','guard','technique','release']",
      "heal:'healing_pill',restore:'spirit_pill'",
      "emit('move',move)",
      "emit('move','flee')",
      "{{cost(move)}} · 3 秒 / 回合",
      "{{retreatEffect}}"
    ],
    "web/src/BattleCast.vue": [
      "import './ta07-cast.css'",
      "from './battle-choreography'",
      "castForNotice(props.notice)",
      "data-testid=\"battle-cast\"",
      ":data-receipt=\"notice.key\"",
      ":data-move=\"cast.move\""
    ],
    "web/src/battle-choreography.ts": [
      "useBattlePreparation",
      "createBattleWitness",
      "useBattleWitness",
      "castForNotice",
      "createActivityEffectTracker(matching)",
      "useActivityPresentation",
      "const matching=(a:Activity)=>a.version===6&&a.plan.kind!=='travel';",
      "a.nextCommand?.type!=='BATTLE'",
      "r.id!==a.id",
      "r.generation!==a.generation",
      "tracker.consume(o,g,a,result,replayed,eligible)",
      "notice.key!==JSON.stringify([prior.runId,prior.commandId])",
      "s.activity?.ownerId",
      "document.hidden",
      "clearBattlePose"
    ],
    "web/src/activity-effects.ts": [
      "a.version&&[2,3,6,extra].includes(a.version)",
      "resolve(before,command)",
      "completeActivity(g,prior,r,",
      "proof(resolved.nextState)!==proof(g)",
      "proof(expected)!==proof(a)"
    ]
  },
  "userAcceptance": false
