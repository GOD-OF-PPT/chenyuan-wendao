{
  "MarketPlanner.vue": [
    [
      "翻看货架 · 更换物资与购售",
      "翻看货架"
    ],
    [
      "'下次安排草案 · 当前执行见活动条':sameSaved&&planSaved?'已保存安排；修改后须重新确认':'待确认的新安排，确认后才开始'",
      "'下次草案 · 原活动不变':sameSaved&&planSaved||restart.same?'已保存安排':'待确认'"
    ],
    [
      "<strong class=\"market-price\">",
      "<strong v-if=\"mode==='buy'||item.sell!==null\" class=\"market-price\">"
    ],
    [
      "{{mode==='buy'?item.buy:item.sell??'不可出售'}}",
      "{{mode==='buy'?item.buy:item.sell}}"
    ],
    [
      "调整本段安排 ›",
      "调整 ›"
    ],
    [
      "    <div class=\"preparation-estimate\" data-testid=\"preparation-estimate\"><template v-if=\"restart.same\"><strong data-testid=\"paused-plan-progress\">{{restart.summary}} 件</strong><small>{{restart.note}}</small></template><template v-else><strong>预计成交 {{quote?.cycles??0}} 件 · {{mode==='buy'?'灵石消耗 '+(quote?.stones??0):'灵石收入 '+(quote?.earnedStones??0)}}</strong><small>{{mode==='buy'?'逐件入囊，目标为最终库存':'逐件扣除库存，突破物不可出售；药物也受保留量约束'}}</small><small>{{quote?.failure?.message??(quote?.stopReason?'预计停止：'+quote.stopReason.message:'')}}</small><small v-if=\"consumptionWarning\" data-testid=\"market-consumption\">整段出售：{{consumptionWarning}}</small></template></div>",
      "    <div class=\"preparation-estimate\" data-testid=\"preparation-estimate\"><strong>{{conflict||(mode==='sell'&&item.sell===null?'突破物不可出售':restart.same?'':quote?.failure?.message)}}</strong><small v-if=\"consumptionWarning\" data-testid=\"market-consumption\">整段出售：{{consumptionWarning}}</small></div>"
    ],
    [
      "前往云岚坊市 · 不自动成交",
      "前往坊市 · 6秒，不成交"
    ],
    [
      "{{conflict?'当前暂不可安排':restart.same?restart.label:restart.label+(mode==='buy'?'安排购入'+item.name:'安排售出'+item.name)}}",
      "{{restart.same?'上方继续交易':restart.label+(mode==='buy'?'开始购入'+item.name:'开始售出'+item.name)}}"
    ],
    [
      ":disabled=\"!!conflict||restart.same||!quote?.allowed\">{{restart.same?'上方继续交易':restart.label+(mode==='buy'?'开始购入'+item.name:'开始售出'+item.name)}}</button><small class=\"preparation-reason\">{{conflict||'限于本段安排；不自动补货、换物或旅行。'}}</small>",
      ":disabled=\"!!conflict||restart.same||!quote?.allowed\">{{restart.same?'上方继续交易':restart.label+(mode==='buy'?'开始购入'+item.name:'开始售出'+item.name)}}</button>"
    ],
    [
      "<p>只调整待确认草案，关闭保留参数；返回后另行确认才成交。</p>",
      "<p>关闭保留，返回确认；逐件成交免领取。</p><div class=\"preparation-estimate\" data-testid=\"market-full-estimate\"><template v-if=\"restart.same\"><strong data-testid=\"paused-plan-progress\">{{restart.summary}} 件</strong><small>{{restart.note}}</small></template><template v-else-if=\"quote?.allowed\"><strong>预计成交 {{quote.cycles}} 件 · {{mode==='buy'?'灵石消耗 '+quote.stones:'灵石收入 '+quote.earnedStones}}</strong><small>{{mode==='buy'?'入囊至目标库存即停':'逐件出售，保留库存；突破物禁售'}}</small><small>{{quote?.stopReason?'预计停止：'+quote.stopReason.message:''}}</small></template><strong v-else>{{mode==='sell'&&item?.sell===null?'突破物不可出售':quote?.failure?.message}}</strong><small>仅执行本单，不自动接续其他行动。</small></div>"
    ],
    [
      "<label>累计采购灵石预算<input",
      "<label>用石上限<input"
    ],
    [
      "<label>采购灵石保留量<input",
      "<label>灵石保留<input"
    ],
    [
      "<label>本段最多（件）<input",
      "<label>最多件数<input"
    ],
    [
      "完成调整 · 返回货架",
      "返回货架"
    ],
    [
      "{{mode==='buy'?'购入':'售出'}}安排</h3>",
      "{{mode==='buy'?'购入':'售出'}}</h3>"
    ],
    [
      "本段最多 {{count}} 件",
      "最多 {{count}} 件"
    ]
  ],
  "MarketCounter.vue": [
    [
      "<div class=\"counter-cycle\" data-testid=\"market-cycle-status\">",
      "<div v-if=\"state!=='idle'||totals\" class=\"counter-cycle\" data-testid=\"market-cycle-status\">"
    ],
    [
      "<small v-else>15 秒 / 件 · 无需逐件领取</small>",
      "<small v-else>15 秒 / 件</small>"
    ],
    [
      "<small class=\"counter-realm\">需{{C.realms[item.min].name}}{{mode==='sell'?'（出售按正式资格）':''}}</small>",
      "<small v-if=\"mode==='buy'\" class=\"counter-realm\">需{{C.realms[item.min].name}}</small>"
    ]
  ]
}
